# Copy to .env and fill in the blanks:  cp .env.example .env
#
# docker-compose reads this file for every Airflow service, and the local
# tools/ scripts expect the same SUPABASE_* variables:
#     set -a && source .env && set +a
#
# Values already filled in are non-secret defaults that work as-is with the
# bundled docker-compose stack. Blank values are secrets you must supply.

# --- Airflow core -----------------------------------------------------------
AIRFLOW__CORE__EXECUTOR=CeleryExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=false
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=

# Host UID the containers run as, so files written to the mounted logs/ and
# output/ directories stay editable. On Linux/WSL use the output of `id -u`.
AIRFLOW_UID=1000

# Cron for the daily scrape. Use "none" (or "manual"/"off") for manual-only
# triggering — see _dag_schedule() in dags/main.py. Example: "0 12 * * *".
AIRFLOW_DAG_SCHEDULE=none

# --- Airflow metadata database (the bundled postgres service) ---------------
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres:5432/airflow

# --- Celery broker (the bundled redis service) ------------------------------
AIRFLOW__CELERY__BROKER_URL=redis://redis:6379/0
AIRFLOW__CELERY__RESULT_BACKEND=db+postgresql://airflow:airflow@postgres:5432/airflow

# --- Airflow webserver login (http://localhost:8080) ------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW__WEBSERVER__SECRET_KEY=
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=

# --- Supabase: the analytics warehouse the pipeline writes to ---------------
# Use the session pooler host (IPv4 compatible). dbt reads these same vars
# via dbt/profiles.yml, as do the read-only scripts in tools/analysis/.
SUPABASE_HOST=
SUPABASE_PORT=5432
SUPABASE_DB=postgres
SUPABASE_USER=
SUPABASE_PASSWORD=

# --- AWS S3: raw scrape payload storage -------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-west-1
S3_BUCKET_NAME=

# --- Telegram alerting (optional) -------------------------------------------
# Leave blank to disable: send_alert() no-ops when either value is unset.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
